platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting build performance.
ENV['COCOAPODS_DISABLE_STATS'] = '1'

# 1. Find the Flutter Root
def flutter_root
  # Priority 1: Environment variable (set by GitHub Actions/Codemagic)
  return ENV['FLUTTER_ROOT'] if ENV['FLUTTER_ROOT']

  # Priority 2: Generated.xcconfig
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  if File.exist?(generated_xcode_build_settings_path)
    File.foreach(generated_xcode_build_settings_path) do |line|
      matches = line.match(/\AFLUTTER_ROOT=(.*)\z/)
      return matches[1] if matches
    end
  end
  ""
end

# 2. Load the podhelper.rb directly from the Flutter SDK
# This ensures we don't depend on locally generated files that might be missing.
sdk_podhelper_path = File.join(flutter_root, 'packages', 'flutter_tools', 'bin', 'podhelper.rb')
if File.exist?(sdk_podhelper_path)
  load sdk_podhelper_path
else
  # Last resort: Try local path
  local_podhelper_path = File.expand_path(File.join('..', 'Flutter', 'podhelper.rb'), __FILE__)
  load local_podhelper_path if File.exist?(local_podhelper_path)
end

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  # 3. Install all Flutter pods
  if defined?(flutter_install_all_ios_pods)
    flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  end

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    # Apply additional Flutter build settings
    if defined?(flutter_additional_ios_build_settings)
      flutter_additional_ios_build_settings(target)
    end

    # Ensure deployment target is consistent at 15.0
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
