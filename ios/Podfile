platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting build performance.
ENV['COCOAPODS_DISABLE_STATS'] = '1'

# Standard Flutter helper
# Note: podhelper.rb is generated by 'flutter pub get' on a Mac.
# We use a rescue block to handle cases where the file isn't present during parsing.
begin
  require_relative 'Flutter/podhelper'
rescue LoadError
  # If podhelper.rb is missing, we still want the target to be defined so pod install doesn't crash,
  # but dependencies will be missing until flutter pub get generates it.
end

project 'Runner', {
  'Debug' => :debug,
  'Release' => :release,
  'Profile' => :profile,
}

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  # Inject all Flutter-related pods
  if defined?(flutter_install_all_ios_pods)
    flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  else
    # Fallback/Warning if helper is missing
    puts "Warning: flutter_install_all_ios_pods not defined. Ensure 'flutter pub get' has run."
  end
  
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    # Apply additional Flutter build settings
    if defined?(flutter_additional_ios_build_settings)
      flutter_additional_ios_build_settings(target)
    end
    
    # Ensure deployment target is consistent at 15.0
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
