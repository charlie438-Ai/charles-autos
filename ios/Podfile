platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting build performance.
ENV['COCOAPODS_DISABLE_STATS'] = '1'

project 'Runner', {
  'Debug' => :debug,
  'Release' => :release,
  'Profile' => :profile,
}

# The following lines are standard for Flutter
def flutter_root
  # Try to get FLUTTER_ROOT from environment (common in CI/CD)
  return ENV['FLUTTER_ROOT'] if ENV['FLUTTER_ROOT']

  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    # If the file doesn't exist, we assume Flutter will generate it or we're in a build environment
    return ""
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/\AFLUTTER_ROOT=(.*)\z/)
    return matches[1] if matches
  end
  ""
end

# Check if we are on a Mac (like Codemagic) before requiring xcode_backend
if File.directory?(File.join(flutter_root, 'packages', 'flutter_tools', 'bin'))
  require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'xcode_backend.rb'), flutter_root)
end

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  # Only call this if we are in a proper Flutter environment
  if defined?(flutter_install_all_ios_pods)
    flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  end
  
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    # Only call this if we are in a proper Flutter environment
    if defined?(flutter_additional_ios_build_settings)
      flutter_additional_ios_build_settings(target)
    end
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
